# ── Identidade e publicação ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dradrianorgermano.com.br
# Enquanto "true", o site sai do índice (robots) e exibe os avisos de dados
# demonstrativos. Identidade e CROs já foram fornecidos; confirme os dados de
# atendimento antes de mudar para "false".
# Indexação. O site é rastreável por padrão; esta variável só existe para
# fechar o índice de propósito (ambiente de teste, domínio provisório).
# Deploys de preview da Vercel já saem fora do índice sozinhos.
NEXT_PUBLIC_SITE_NOINDEX=

# Dados de atendimento provisórios. Vale só enquanto NEXT_PUBLIC_SITE_NOINDEX
# estiver ligado: abrir o índice desliga o modo demo e apaga endereço,
# telefone e mapa em vez de publicá-los inventados.
NEXT_PUBLIC_SITE_IS_DEMO=true

# ── Contato ──────────────────────────────────────────────────────────────
# Todos os links abrem diretamente o WhatsApp de João Pessoa.
# O número está definido em contactLocation, em lib/site.ts.


# ── Perfis oficiais (entram em sameAs no schema) ─────────────────────────
# Perfil oficial informado pelo cliente.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/dr.adrianorgermano/

# GTM: configurado diretamente em components/gtm.tsx.
# Contato exclusivamente pelo WhatsApp; sem integração de formulário.
